API_HOST=
API_PORT=
API_ENV=
PORT=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
CORS_ORIGINS=

# ── Detección de plantas con IA ───────────────────────────────────────────────
# Proveedor: "openai" (por defecto → cualquier API compatible con OpenAI:
# OpenRouter, HuggingFace router, Groq…) o "gemini" (API nativa de Google).
AI_PROVIDER=openai
# URL base del proveedor compatible con OpenAI:
#   OpenRouter:   https://openrouter.ai/api/v1
#   HuggingFace:  https://router.huggingface.co/v1
#   Groq:         https://api.groq.com/openai/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Modelo(s) de visión (deben aceptar imágenes). Puedes poner VARIOS separados
# por comas: el backend los prueba en orden hasta que alguno responda
# (fallback automático ante 503 / saturación de modelos :free).
# OJO: los slugs :free de OpenRouter cambian con el tiempo. Verifica los
# vigentes en https://openrouter.ai/models?max_price=0 (filtro: input=image).
#   OpenRouter (verificados): google/gemma-4-31b-it:free
#                             nvidia/nemotron-nano-12b-v2-vl:free
#                             google/gemma-4-26b-a4b-it:free
#   HuggingFace:              Qwen/Qwen2.5-VL-7B-Instruct
AI_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-nano-12b-v2-vl:free,google/gemma-4-26b-a4b-it:free

# Alternativa: API nativa de Gemini (solo si AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=