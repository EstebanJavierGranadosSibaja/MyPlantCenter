API_HOST=
API_PORT=
API_ENV=
PORT=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=
CORS_ORIGINS=

# ── Detección de plantas con IA ───────────────────────────────────────────────
# Proveedor: "openai" (por defecto → cualquier API compatible con OpenAI:
# OpenRouter, HuggingFace router, Groq…) o "gemini" (API nativa de Google).
AI_PROVIDER=openai
# URL base del proveedor compatible con OpenAI:
#   OpenRouter:   https://openrouter.ai/api/v1
#   HuggingFace:  https://router.huggingface.co/v1
#   Groq:         https://api.groq.com/openai/v1
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Modelo de visión (debe aceptar imágenes). Ejemplos gratuitos:
#   OpenRouter:   meta-llama/llama-3.2-11b-vision-instruct:free
#   HuggingFace:  Qwen/Qwen2.5-VL-7B-Instruct
AI_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# Alternativa: API nativa de Gemini (solo si AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=