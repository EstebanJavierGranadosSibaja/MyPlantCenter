{
  "name": "myplantcenter-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "frontend:install": "npm --prefix frontend install",
    "frontend:start": "npm --prefix frontend run start",
    "frontend:android": "npm --prefix frontend run android",
    "frontend:ios": "npm --prefix frontend run ios",
    "frontend:lint": "npm --prefix frontend run lint",
    "backend:install": "pip install -r backend/requirements.txt",
    "backend:start": "cd backend && python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "backend:start:local": "cd backend && python -m uvicorn main:app --host 127.0.0.1 --port 8000",
    "backend:check:firestore-contract": "python backend/scripts/validate_firestore_contract.py",
    "data:normalize": "node utils/scripts/normalize-db.mjs",
    "data:check:seed": "node utils/scripts/check-seed-structure.js",
    "data:export": "node utils/scripts/firestore-export.js",
    "data:import": "node utils/scripts/firestore-import.js",
    "data:import:seed": "node utils/scripts/firestore-import-seed.js",
    "data:import:seed:clean": "node utils/scripts/firestore-import-seed-clean.js",
    "data:check:firestore-schema": "node utils/scripts/check-firestore-postimport.js",
    "data:check:firestore-freshness": "node utils/scripts/check-firestore-freshness.js"
  },
  "dependencies": {
    "firebase-admin": "^8.13.0"
  }
}
